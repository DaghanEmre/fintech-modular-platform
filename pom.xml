<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.daghanemre.fintech</groupId>
    <artifactId>fintech-modular-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Fintech Modular Platform</name>
    <description>Platform root — Dependency Governor for all modules (ADR-0008)</description>

    <modules>
        <module>common/fintech-common</module>
        <module>services/customer-service</module>
    </modules>

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║  PLATFORM VERSION CATALOG                                        ║
    ║  Single source of truth. Change versions HERE ONLY.             ║
    ║  Services declare deps without version — flows from BOM.        ║
    ║  See: ADR-0008 — Spring Boot Upgrade & Dependency Governance    ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->
    <properties>
        <!-- Java -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Platform Framework -->
        <spring-boot.version>3.5.14</spring-boot.version>

        <!-- Mapping & Code Generation -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>

        <!-- Testing -->
        <testcontainers.version>1.21.0</testcontainers.version>
        <archunit.version>1.3.0</archunit.version>

        <!-- Build Plugins -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    </properties>

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║  PLATFORM BOM                                                    ║
    ║  Governs ALL dependency versions across ALL modules.            ║
    ║  Rationale: framework parent inheritance ≠ platform governance. ║
    ║  See: ADR-0008 §"Why BOM Instead of Parent Inheritance?"        ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot BOM — governs entire Spring + Jakarta ecosystem -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM — governs all testcontainers modules -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MapStruct (not covered by Spring BOM) -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- ArchUnit (not covered by Spring BOM) -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Internal modules — version aligned with platform -->
            <dependency>
                <groupId>com.daghanemre.fintech</groupId>
                <artifactId>fintech-common</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║  PLATFORM PLUGIN MANAGEMENT                                      ║
    ║  Plugin versions centralized — services inherit, not redeclare. ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->
    <build>
        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!--
                        Use 'release' flag instead of source/target pair:
                        Enforces target JDK API consistency, prevents accidental
                        use of newer JDK APIs, and produces cleaner bytecode for Java 21.
                        -->
                        <release>${java.version}</release>
                        <!--
                        parameters=true: Required for Spring MVC parameter binding,
                        reflection-based constructor resolution, and JPA proxy scenarios.
                        Without this, @RequestParam name inference and some DI features break.
                        -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>

            </plugins>
        </pluginManagement>

        <!--
        Enforcer executes on every build (validate phase).
        Rules are defined here — not in child modules — to enforce platform-wide governance.
        See: ADR-0008 §"Dependency Governance"
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>

                    <!-- EXECUTION 1: Platform baseline invariants -->
                    <execution>
                        <id>enforce-platform-baseline</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <!-- Java 21 is non-negotiable for this platform (ADR-0008) -->
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Platform requires Java 21 or higher (ADR-0008). Current: ${java.version}</message>
                                </requireJavaVersion>
                                <!-- Maven 3.8.1+ blocks HTTP repository access (security baseline) -->
                                <requireMavenVersion>
                                    <version>[3.8.1,)</version>
                                    <message>Maven 3.8.1+ required (security: HTTP dependency blocking). Current: ${maven.version}</message>
                                </requireMavenVersion>
                                <!-- Fail on transitive dependency version conflicts -->
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>

                    <!-- EXECUTION 2: Banned EOL dependencies -->
                    <!--
                    Only Spring Boot 3.2.x is EOL (since 2024-12-31).
                    Maven Enforcer bannedDependencies uses groupId:artifactId[:type[:classifier[:version]]] format.
                    Wildcard on version is not natively supported — requireUpperBoundDeps is
                    a future addition once the ecosystem (Netty, Jackson) stabilizes.
                    The dependencyConvergence rule above already guards against version drift.
                    -->
                    <execution>
                        <id>enforce-banned-namespace</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>Old javax.* namespace detected. Platform uses jakarta.* exclusively (Spring Boot 3.x).</message>
                                    <excludes>
                                        <!-- Ban old javax.* namespace: platform uses jakarta.* exclusively -->
                                        <exclude>javax.servlet:servlet-api</exclude>
                                        <exclude>javax.inject:javax.inject</exclude>
                                        <exclude>javax.persistence:javax.persistence-api</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>

                    <!-- EXECUTION 3: Banned EOL Spring Boot versions (ADR-0008) -->
                    <execution>
                        <id>enforce-banned-eol-spring-boot</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>Spring Boot 3.2.x (and earlier EOL versions) is banned by ADR-0008.</message>
                                    <excludes>
                                        <exclude>org.springframework.boot:*:[1.0.0,3.3.0-M1)</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>

</project>
